# Eventora AI — backend environment configuration
# Copy to .env and fill in values. Never commit the real .env file.

# --- Server ---
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite file for local development. Swap for a Postgres/Supabase URL in production.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/eventora

# --- AI provider ---
# "openai" | "anthropic" | "none"  (none => deterministic rule-based fallback)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60

# --- Paths ---
# Where trained joblib artifacts live (relative to backend/).
ML_MODEL_DIR=ml_artifacts
